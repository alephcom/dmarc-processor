{
	email {$ACME_EMAIL}
}

# Web UI
{$APP_HOST} {
	encode zstd gzip

	# The app sets the security headers (HSTS, frame-ancestors, Referrer-Policy...); just don't advertise Caddy.
	header -Server

	# Internal endpoints are only for smtp-receiver on the Docker network.
	@internal path /internal/*
	respond @internal 404

	reverse_proxy web:8080
}

# Hostname of the reports MX. We only need Caddy to obtain/renew its TLS certificate,
# which smtp-receiver reads from the shared caddy_data volume for STARTTLS.
{$MX_HOSTNAME} {
	respond "This host only receives DMARC reports by email." 404
}
