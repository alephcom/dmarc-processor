# ---- Copy to .env and fill in. Used by docker compose and by the Laravel containers. ----

# Public hostnames (DNS A/AAAA records must point at this server)
APP_HOST=dmarc.example-msp.com
REPORTS_DOMAIN=reports.example-msp.com
MX_HOSTNAME=mx.reports.example-msp.com
ACME_EMAIL=ops@example-msp.com

# Laravel
APP_NAME="DMARC Monitor"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://dmarc.example-msp.com
# Generate with: docker compose run --rm web php artisan key:generate --show
APP_KEY=

# Shared secret between smtp-receiver and the app (generate with: openssl rand -hex 32)
INGEST_HMAC_SECRET=

# Database
DB_DATABASE=dmarc
DB_USERNAME=dmarc
DB_PASSWORD=

# Outbound mail for alerts and digests (your SMTP relay or transactional provider)
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=dmarc@example-msp.com
MAIL_FROM_NAME="${APP_NAME}"

# Optional: IPinfo Lite instead of DB-IP for sender identification (free token at ipinfo.io)
IPINFO_TOKEN=

# Branding on printable reports
DMARC_BRAND_NAME="${APP_NAME}"
DMARC_BRAND_LOGO_URL=
DMARC_BRAND_CONTACT=
# Public home page at "/" with a "request a free account" form (docs/INSTALL.md §7)
PUBLIC_SITE_ENABLED=false
# Cloudflare Turnstile keys for the request form (https://dash.cloudflare.com → Turnstile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional single sign-on for customer users (see docs/INSTALL.md). Leave empty to hide the buttons.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Session cookies only over HTTPS (default when APP_URL is https://)
SESSION_SECURE_COOKIE=true

LOG_CHANNEL=stderr
